<resources>

    <!-- Base Styles for Dot Inheritance -->
    <style name="Widget.App" parent="android:Widget" />
    <style name="Widget.App.Button" parent="android:Widget.Button" />
    <style name="TextAppearance.App" parent="android:TextAppearance" />

    <style name="Widget.App.InputRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
    </style>

    <style name="Widget.App.InputIcon">
        <item name="android:layout_width">@dimen/icon_size</item>
        <item name="android:layout_height">@dimen/icon_size</item>
        <item name="tint">@color/color_text_secondary</item>
    </style>

    <style name="Widget.App.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_sm</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
    </style>

    <style name="Widget.App.Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_button_text</item>
    </style>

    <style name="TextAppearance.App.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.App.Link">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="TextAppearance.App.FooterText">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

</resources>